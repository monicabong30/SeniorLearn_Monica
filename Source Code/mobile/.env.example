# Development only. Web: http://localhost:4000/api; Android emulator: http://10.0.2.2:4000/api.
# A physical development device needs this computer's reachable LAN address.
# Production must be a public HTTPS URL, e.g. https://api.example.com/api. Never put secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:4000/api
