PORT=4000
HOST=0.0.0.0
HTTPS_ENABLED=true
# Paths are resolved from backend/, regardless of whether npm is launched from the repository root.
HTTPS_KEY_PATH=./certs/server.key
HTTPS_CERT_PATH=./certs/server.crt
MONGODB_URI=mongodb+srv://<db_username>:<url-encoded-db-password>@<cluster-host>/seniorlearn?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
# Local demonstration payments are simulated in the application. No external
# payment credentials or listener process is required.
# Production: exact browser origins only, comma-separated (for example https://app.example.org).
# Development browser origin (use HTTPS after trusting the local SeniorLearn CA).
CLIENT_ORIGIN=https://localhost:8081
# TRUST_PROXY=true when exactly one trusted hosting proxy is in front of the API.
# NODE_ENV=production requires CLIENT_ORIGIN. Set this to the browser app origin(s), comma-separated.
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# Atlas uses TLS by default; do not set tls=false or tlsAllowInvalidCertificates=true.
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=1
# MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
# MONGODB_CONNECT_TIMEOUT_MS=10000
# MONGODB_SOCKET_TIMEOUT_MS=30000
